# Copiá este archivo como ".env" y completá tus datos reales.
# NUNCA subas el archivo .env a GitHub.

PORT=3001

# Supabase -> botón "Connect" -> "Session pooler" (ver GUIA_PASO_A_PASO.md)
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_CLAVE@aws-0-xx-xxxx-x.pooler.supabase.com:5432/postgres

# Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=pegá_acá_la_clave_secret_o_service_role

# Clave del administrador (la elegís vos)
ADMIN_CLAVE=cambiame

# true = permite sacar la foto a cualquier hora (solo para probar)
MODO_PRUEBA=true
